<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SevenRecord.Media\SevenRecord.Media.csproj" />
    <ProjectReference Include="..\SevenRecord.Export\SevenRecord.Export.csproj" />
    <ProjectReference Include="..\SevenRecord.Analysis\SevenRecord.Analysis.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
