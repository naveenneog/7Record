<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SevenRecord.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SevenRecord.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource StudioBackgroundBrush}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.ColumnSpan="2"
            Padding="24,0"
            Background="{StaticResource StudioSurfaceBrush}"
            BorderBrush="{StaticResource StudioDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Ellipse
                        Width="12"
                        Height="12"
                        Fill="{StaticResource RecordBrush}" />
                    <TextBlock
                        FontFamily="{StaticResource DisplayFont}"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StudioInkBrush}"
                        Text="7Record" />
                </StackPanel>
                <Button
                    x:Name="StartRecordingButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Start recording"
                    Click="OnStartRecordingClicked"
                    Content="Record"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Global shortcut: Ctrl+Shift+R" />
                <Button
                    x:Name="PauseRecordingButton"
                    Margin="0,0,150,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnPauseRecordingClicked"
                    Content="Pause"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Global shortcut: Ctrl+Shift+P" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="16,24"
            Background="{StaticResource StudioSurfaceBrush}"
            BorderBrush="{StaticResource StudioDividerBrush}"
            BorderThickness="0,0,1,0">
            <StackPanel Spacing="8">
                <Button
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Open recorder"
                    Content="Recorder"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button
                    x:Name="ProjectsNavigationButton"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Open projects"
                    Click="OnProjectsClicked"
                    Content="Projects"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Open settings"
                    Content="Settings"
                    Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </Border>

        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1120"
                Padding="40,36,40,56"
                HorizontalAlignment="Stretch"
                Spacing="28">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Record now" />
                    <TextBlock
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Press Record to capture the primary display, default camera, microphone, and system audio. Use Choose application or display only when you want a different source."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="20"
                        Background="{StaticResource StudioSurfaceBrush}"
                        BorderBrush="{StaticResource StudioDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Screen" />
                            <TextBlock
                                x:Name="ScreenStatusText"
                                Style="{StaticResource BodyTextStyle}"
                                Text="Checking Windows screen capture..."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="ChooseSourceButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Choose an application or display"
                                Click="OnChooseSourceClicked"
                                Content="Choose application or display" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="20"
                        Background="{StaticResource StudioSurfaceBrush}"
                        BorderBrush="{StaticResource StudioDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Camera" />
                            <TextBlock
                                x:Name="CameraStatusText"
                                Style="{StaticResource BodyTextStyle}"
                                Text="Checking camera devices..."
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Name="CameraOverlayToggle"
                                Header="Include camera overlay"
                                IsOn="True"
                                Toggled="OnCameraOverlayToggled" />
                            <Button
                                x:Name="ConfigureCameraButton"
                                HorizontalAlignment="Left"
                                Click="OnConfigureCameraClicked"
                                Content="Test camera" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="20"
                        Background="{StaticResource StudioSurfaceBrush}"
                        BorderBrush="{StaticResource StudioDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Audio" />
                            <TextBlock
                                x:Name="AudioStatusText"
                                Style="{StaticResource BodyTextStyle}"
                                Text="Checking microphone and system audio..."
                                TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Content="Configure audio" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        MinHeight="360"
                        Background="#FF080808"
                        BorderBrush="{StaticResource StudioDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SectionTitleStyle}"
                                Text="Preview" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyTextStyle}"
                                Text="Your selected screen and presenter layout will appear here." />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="22"
                        Background="{StaticResource StudioRaisedBrush}"
                        BorderBrush="{StaticResource StudioDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="18">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recording health" />
                            <Button
                                x:Name="RefreshReadinessButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Refresh recording health"
                                Click="OnRefreshReadinessClicked"
                                Content="Refresh checks" />
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource StudioInkBrush}" Text="Storage" />
                                <TextBlock
                                    x:Name="StorageStatusText"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="Checking available space..." />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource StudioInkBrush}" Text="Encoder" />
                                <TextBlock
                                    x:Name="EncoderStatusText"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="Checking FFmpeg encoders..."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource StudioInkBrush}" Text="Frames" />
                                <TextBlock
                                    x:Name="FrameStatusText"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="No active capture."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource StudioInkBrush}" Text="Shortcuts" />
                                <TextBlock
                                    x:Name="HotkeyStatusText"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="Registering global shortcuts..."
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RefreshHotkeysButton"
                                    HorizontalAlignment="Left"
                                    Click="OnRefreshHotkeysClicked"
                                    Content="Retry shortcuts" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource StudioInkBrush}" Text="Recovery" />
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="Segments will be finalized during recording." TextWrapping="Wrap" />
                            </StackPanel>
                            <InfoBar
                                x:Name="ReadinessInfoBar"
                                IsClosable="False"
                                IsOpen="True"
                                Message="Recording checks are running."
                                Severity="Informational"
                                Title="Preparing recorder" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    x:Name="ProjectsSection"
                    Padding="24"
                    Background="{StaticResource StudioSurfaceBrush}"
                    BorderBrush="{StaticResource StudioDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recent projects" />
                            <Button
                                x:Name="RefreshProjectsButton"
                                HorizontalAlignment="Right"
                                Click="OnRefreshProjectsClicked"
                                Content="Refresh" />
                        </Grid>
                        <TextBlock
                            x:Name="ProjectsEmptyText"
                            Style="{StaticResource BodyTextStyle}"
                            Text="No recording projects yet." />
                        <ListView
                            x:Name="RecentProjectsList"
                            MaxHeight="360"
                            IsItemClickEnabled="True"
                            ItemClick="OnProjectItemClicked"
                            SelectionMode="None" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TimelineSection"
                    Padding="24"
                    Background="{StaticResource StudioSurfaceBrush}"
                    BorderBrush="{StaticResource StudioDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Editor timeline" />
                        <TextBlock
                            x:Name="TimelineProjectTitle"
                            Style="{StaticResource BodyTextStyle}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="RenderPresetComboBox"
                                Header="Export framing"
                                SelectedIndex="0"
                                SelectionChanged="OnRenderPresetChanged">
                                <ComboBoxItem Content="Landscape 1920 × 1080" />
                                <ComboBoxItem Content="Portrait 1080 × 1920" />
                                <ComboBoxItem Content="Square 1080 × 1080" />
                            </ComboBox>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="OnSaveRenderPlanClicked"
                                Content="Save render plan" />
                        </Grid>
                        <Button
                            x:Name="ExportMp4Button"
                            HorizontalAlignment="Left"
                            Click="OnExportMp4Clicked"
                            Content="Export MP4" />
                        <Button
                            x:Name="GenerateCaptionsButton"
                            HorizontalAlignment="Left"
                            Click="OnGenerateCaptionsClicked"
                            Content="Generate local captions" />
                        <StackPanel
                            x:Name="CaptionEditorPanel"
                            Spacing="10"
                            Visibility="Collapsed">
                            <ComboBox
                                x:Name="CaptionSelectorComboBox"
                                Header="Caption segment"
                                SelectionChanged="OnCaptionSelectionChanged" />
                            <TextBox
                                x:Name="CaptionTextBox"
                                Header="Caption text"
                                AcceptsReturn="True"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="CaptionStartNumberBox"
                                    Header="Start seconds"
                                    Minimum="0"
                                    SmallChange="0.1" />
                                <NumberBox
                                    x:Name="CaptionEndNumberBox"
                                    Grid.Column="1"
                                    Header="End seconds"
                                    Minimum="0"
                                    SmallChange="0.1" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnApplyCaptionEditClicked" Content="Apply caption edit" />
                                <Button
                                    x:Name="UndoCaptionButton"
                                    Click="OnUndoCaptionClicked"
                                    Content="Undo"
                                    IsEnabled="False" />
                                <Button
                                    x:Name="RedoCaptionButton"
                                    Click="OnRedoCaptionClicked"
                                    Content="Redo"
                                    IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            x:Name="RenderPlanSummaryText"
                            Style="{StaticResource BodyTextStyle}"
                            TextWrapping="Wrap" />
                        <ListView
                            x:Name="TimelineItemsList"
                            MaxHeight="420"
                            SelectionMode="None" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
