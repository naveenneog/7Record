<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SevenRecord.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SevenRecord.App"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioRaisedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="StudioDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RecordBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="RecordHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="RecordPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="RecordTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AutomationBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AutomationTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SuccessTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Color x:Key="StudioBackgroundColor">#FF0E0D0E</Color>
            <Color x:Key="StudioSurfaceColor">#FF181618</Color>
            <Color x:Key="StudioRaisedColor">#FF242124</Color>
            <Color x:Key="StudioDividerColor">#FF6B6368</Color>
            <Color x:Key="StudioInkColor">#FFF8F4F6</Color>
            <Color x:Key="StudioMutedColor">#FFB2AAB0</Color>
            <Color x:Key="RecordColor">#FFA94375</Color>
            <Color x:Key="RecordHoverColor">#FFB14A7E</Color>
            <Color x:Key="RecordPressedColor">#FF8A315B</Color>
            <Color x:Key="RecordTintColor">#33A94375</Color>
            <Color x:Key="AutomationColor">#FF45BFD2</Color>
            <Color x:Key="AutomationTintColor">#2445BFD2</Color>
            <Color x:Key="SuccessColor">#FF55C58A</Color>
            <Color x:Key="SuccessTintColor">#2455C58A</Color>
            <Color x:Key="WarningColor">#FFE9B44C</Color>
            <Color x:Key="DangerColor">#FFE06464</Color>

            <SolidColorBrush x:Key="StudioBackgroundBrush" Color="{StaticResource StudioBackgroundColor}" />
            <SolidColorBrush x:Key="StudioSurfaceBrush" Color="{StaticResource StudioSurfaceColor}" />
            <SolidColorBrush x:Key="StudioRaisedBrush" Color="{StaticResource StudioRaisedColor}" />
            <SolidColorBrush x:Key="StudioDividerBrush" Color="{StaticResource StudioDividerColor}" />
            <SolidColorBrush x:Key="StudioInkBrush" Color="{StaticResource StudioInkColor}" />
            <SolidColorBrush x:Key="StudioMutedBrush" Color="{StaticResource StudioMutedColor}" />
            <SolidColorBrush x:Key="RecordBrush" Color="{StaticResource RecordColor}" />
            <SolidColorBrush x:Key="RecordHoverBrush" Color="{StaticResource RecordHoverColor}" />
            <SolidColorBrush x:Key="RecordPressedBrush" Color="{StaticResource RecordPressedColor}" />
            <SolidColorBrush x:Key="RecordTintBrush" Color="{StaticResource RecordTintColor}" />
            <SolidColorBrush x:Key="AutomationBrush" Color="{StaticResource AutomationColor}" />
            <SolidColorBrush x:Key="AutomationTintBrush" Color="{StaticResource AutomationTintColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

            <FontFamily x:Key="DisplayFont">Aptos</FontFamily>
            <FontFamily x:Key="BodyFont">Aptos</FontFamily>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource StudioInkBrush}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource StudioInkBrush}" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LineHeight" Value="24" />
                <Setter Property="Foreground" Value="{StaticResource StudioMutedBrush}" />
            </Style>

            <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource StudioMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource StudioInkBrush}" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AutomationBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource StudioBackgroundBrush}" />
            </Style>

            <Style x:Key="RecordButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{StaticResource RecordBrush}" />
                <Setter Property="Foreground" Value="{StaticResource StudioInkBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AutomationBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource StudioBackgroundBrush}" />
            </Style>

            <Style TargetType="ToggleSwitch">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="Foreground" Value="{StaticResource StudioInkBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AutomationBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
